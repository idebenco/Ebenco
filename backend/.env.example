# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/rental-management
# For production, use MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/rental-management

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRE=7d

# Stripe (Payment Processing)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# AWS S3 (File Storage) - Optional
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=rental-documents

# CORS Configuration (CRITICAL FOR SECURITY)
# Comma-separated list of allowed origins (NO SPACES)
# Development: localhost URLs
# Production: YOUR ACTUAL DOMAINS (never use * in production)
CORS_ORIGIN=http://localhost:3000,http://localhost:19006
# Production example:
# CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com,https://admin.yourdomain.com
